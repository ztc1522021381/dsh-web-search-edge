{
    "name":  "dsh-web-search-edge",
    "version":  "0.4.0",
    "description":  "Keyless, zero-cost web_search for DeepSeek Harness: renders Shenma with your local Edge browser over CDP and reads Bing over HTTP. No API key, no model call, no bill.",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=20",
                    "dsh":  "\u003e=0.1.5-rc.1"
                },
    "main":  "index.js",
    "types":  "./types/index.d.ts",
    "icon":  "./icon.png",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/ztc1522021381/dsh-web-search-edge.git"
                   },
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "web-search",
                     "edge",
                     "free",
                     "keyless",
                     "shenma",
                     "bing"
                 ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "exports":  {
                    ".":  {
                              "types":  "./types/index.d.ts",
                              "default":  "./index.js"
                          },
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "icon.png",
                  "index.js",
                  "types/index.d.ts",
                  "cordis.patch.yml",
                  "LICENSE",
                  "README.md",
                  "README.en.md",
                  "selftest.mjs"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "license":  "MIT",
    "scripts":  {
                    "test":  "node selftest.mjs",
                    "test:offline":  "node selftest.mjs --offline"
                },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "\u003e=4.0.1",
                             "@deepseek-ai/dsh-web":  "\u003e=0.1.5-rc.1"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/dsh-web":  {
                                                              "optional":  false
                                                          }
                             },
    "dependencies":  {
                         "@deepseek-ai/schemastery":  "\u003e=3.18.4"
                     }
}
